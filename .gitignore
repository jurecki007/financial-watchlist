.claude/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — never commit real keys.
# Deny-by-default: ignore every .env* variant, then re-admit only the template.
# An explicit list missed .env.development / .env.test / .env.staging, which
# Next.js loads and developers do create.
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo

# supabase — local stack state; migrations ARE committed
.branches
.temp
supabase/.temp
