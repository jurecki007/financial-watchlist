# Copy to .env.local and fill in. Never commit .env.local.

# Absolute origin of this deployment, used to build the OAuth redirect target.
# Optional — falls back to the forwarded host — but setting it explicitly
# removes any dependence on request headers being present.
NEXT_PUBLIC_SITE_URL=

# --- Supabase -------------------------------------------------------------
# Naming follows Supabase's current API-key system, not the legacy JWT one:
#   publishable (sb_publishable_...) replaces the old anon key
#   secret      (sb_secret_...)      replaces the old service_role key
# Both are found under Settings → API keys.

# Safe to expose to the browser — RLS is what actually enforces access.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Bypasses RLS entirely — never prefix with NEXT_PUBLIC_,
# never import into a client component.
SUPABASE_SECRET_KEY=

# --- Market data ----------------------------------------------------------
# Two providers because neither free tier covers the full surface alone.
# Twelve Data: quotes, historical OHLC, symbol search. 800 credits/day, 8/min.
TWELVE_DATA_API_KEY=

# Finnhub: company news, fundamentals. 60 calls/min, US markets.
FINNHUB_API_KEY=

# --- Email ----------------------------------------------------------------
# Used by the price-alert and digest edge functions.
RESEND_API_KEY=

# --- Alerts ---------------------------------------------------------------
# Shared secret gating the check-price-alerts function, which is deployed
# --no-verify-jwt and so reachable by anyone who knows its URL. Must match the
# CRON_SECRET set on the edge function itself, and the `cron_secret` row in
# Vault that the hourly schedule reads.
#
# Server-only. Creating an alert uses it to ask for an immediate check, so a
# threshold that is already met fires now rather than at the top of the hour.
# Unset is not fatal: the alert is still saved and the hourly sweep still
# catches it, and the server log says the check was skipped.
CRON_SECRET=
